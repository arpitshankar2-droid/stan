# Neon — pooled connection string (host contains "-pooler") for runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon — direct connection string (same, without "-pooler") for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Google AI Studio key for gemini-2.5-flash-lite
GEMINI_API_KEY=""

# Giphy API key — server-side only, for the result-page reaction GIF
GIPHY_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Universe builds allowed per day before we show "at capacity" (stays under Gemini free tier)
DAILY_BUILD_CEILING="200"
