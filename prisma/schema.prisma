generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled (-pooler) — runtime
  directUrl = env("DIRECT_URL") // Neon direct — migrations only
}

enum UniverseStatus {
  BUILDING
  READY
  FAILED
}

enum QuoteSource {
  SCRAPED
  GENERATED
  MIXED
}

enum ReportReason {
  WRONG_ANSWER
  BAD_QUOTE
  OTHER
}

model Universe {
  id         String         @id @default(cuid())
  slug       String         @unique
  name       String
  aliases    String[]       @default([])
  status     UniverseStatus @default(BUILDING)
  source     QuoteSource?
  characters Json?
  tiers      Json?
  failReason String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  questions  Question[]
  results    Result[]
}

model Question {
  id             String      @id @default(cuid())
  universeId     String
  universe       Universe    @relation(fields: [universeId], references: [id], onDelete: Cascade)
  quote          String
  answer         String
  options        String[]
  // The distractor Gemini ranked most confusable with the answer, for the
  // hard-tier "duel" quiz format (answer + this one, not a random pick from
  // the 3). Null on questions generated before this field existed, or on the
  // rare item where Gemini's ranking didn't match any of its own distractors
  // — duel serving falls back to a random distractor in that case.
  duelDistractor String?
  difficulty     Int
  source         QuoteSource
  context        String?
  quoteHash      String

  @@unique([universeId, quoteHash])
  @@index([universeId, difficulty])
}

// Deliberately no relation to Question: a build's questions get wiped and
// recreated wholesale on rebuild (see pipeline.ts), and a report should
// survive that rather than cascade-delete with the row it was filed against.
model QuestionReport {
  id         String       @id @default(cuid())
  questionId String
  reason     ReportReason
  createdAt  DateTime     @default(now())

  @@index([questionId])
}

model Result {
  id          String   @id @default(cuid())
  universeId  String
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  name        String?
  score       Int
  questionIds String[]
  answers     Json
  tier        String
  roast       String
  bestStreak  Int      @default(0)
  challengeOf String?
  createdAt   DateTime @default(now())

  @@index([universeId])
  @@index([challengeOf])
}
